# ============================================================
# DODO-TJ 批量商品上架服务 — 环境变量配置
# ============================================================
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
# ============================================================

# Supabase 配置（必填，使用 Service Role Key 绕过 RLS）
SUPABASE_URL=https://qcrcgpwlfouqslokwbzl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 阿里云百炼 DashScope API Key（必填）
# 获取方式：https://bailian.console.aliyun.com → API Key 管理
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 处理器配置（可选，以下为默认值）
CONCURRENCY=3                 # 并发处理数（建议 1-5，受 API 限流影响）
POLL_INTERVAL_MS=10000        # 轮询间隔（毫秒）
MAX_RETRY_COUNT=3             # 最大重试次数
AI_REQUEST_TIMEOUT_MS=60000   # AI API 单次请求超时（毫秒）
ORPHAN_TIMEOUT_MS=600000      # 孤儿任务超时阈值（毫秒，默认 10 分钟）

# 商品默认值（可选）
DEFAULT_PRICE=39.90           # 默认价格（TJS）
DEFAULT_STOCK=100             # 默认库存
DEFAULT_CURRENCY=TJS          # 默认货币

# 健康检查端口（可选）
HEALTH_PORT=9090              # HTTP 健康检查端点端口
